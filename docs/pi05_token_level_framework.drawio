        <mxCell id="ki_note" value="Knowledge Insulation (KI): action/tactile loss uses detached prefix KV cache, so gradients from this loss do not update SigLIP + VLM prefix backbone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontSize=13;" vertex="1" parent="1">
